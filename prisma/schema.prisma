generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubLogin   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  projectsCreated Project[]     @relation("ProjectCreator")
  tasksAssigned   Task[]        @relation("TaskAssignee")
  comments        TaskComment[]
  invitesSent     Invite[]      @relation("InviteSender")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Workspaces ----------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id              String  @id @default(cuid())
  name            String
  personal        Boolean @default(false)
  plan            Plan    @default(FREE)
  // Monthly AI-task usage for plan limits. Deleting tasks doesn't refund quota.
  usagePeriod     String? // "YYYY-MM" (UTC)
  tasksThisPeriod Int     @default(0)

  // Lemon Squeezy billing (per-seat Pro). Kept in sync by the webhook.
  lsCustomerId         String?
  lsSubscriptionId     String?   @unique
  lsSubscriptionItemId String?
  subscriptionStatus   String? // on_trial | active | past_due | paused | unpaid | cancelled | expired
  seats                Int       @default(1)
  currentPeriodEnd     DateTime? // renews_at, or ends_at once cancelled
  billingUpdatedAt     DateTime? // subscription.updated_at of the last applied event (ignore older ones)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  invites  Invite[]
  projects Project[]
}

model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String?
  role        Role      @default(MEMBER)
  token       String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ---------- Ghost PM ----------

enum Plan {
  FREE
  PRO
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum TaskStatus {
  todo
  doing
  done
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String?
  name        String
  description String   @default("")
  techStack   String   @default("")
  githubRepo  String? // "owner/repo"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  captures  Capture[]
  tasks     Task[]
  roadmaps  Roadmap[]

  @@index([workspaceId])
}

model Capture {
  id        String   @id @default(cuid())
  projectId String
  text      String   @default("")
  imageUrl  String?  @db.Text // v1: base64 data URL
  source    String   @default("text") // text | voice | image | mixed
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id             String     @id @default(cuid())
  projectId      String
  captureId      String?
  assigneeId     String?
  title          String
  why            String     @default("")
  priority       Priority   @default(P2)
  status         TaskStatus @default(todo)
  agentPrompt    String?    @db.Text
  githubIssueUrl String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capture  Capture?      @relation(fields: [captureId], references: [id], onDelete: SetNull)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([createdAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Roadmap {
  id        String   @id @default(cuid())
  projectId String
  weekStart DateTime
  content   Json // { thisWeek: [{taskId,title,reason}], later: [...], ignore: [...] }
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, weekStart])
}

// Raw billing webhooks, for auditing and debugging.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventName   String
  payload     Json
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, createdAt])
}
