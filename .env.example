# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghostpm?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the app (needed in production / behind proxies)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# GitHub OAuth App — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Free-plan monthly task limit
FREE_TASKS_PER_MONTH=20

# Optional: GitHub API base URL (only change for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3)
# GITHUB_API_URL="https://api.github.com"

# Lemon Squeezy billing (optional — Pro checkout is hidden until all four are set)
# Create a subscription product with a per-seat monthly variant, then a webhook pointing at
#   https://YOUR_DOMAIN/api/webhooks/lemonsqueezy  with the subscription_* events enabled.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# LEMONSQUEEZY_TEST_MODE=true
PRO_PRICE_PER_SEAT=12

# Object storage for screenshots (optional — falls back to Postgres). Works with AWS S3,
# Cloudflare R2 (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto) or MinIO.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email via Resend (optional — emails are skipped when unset)
RESEND_API_KEY=""
# e.g. "Ghost PM <hello@yourdomain.com>" — must be a domain verified in Resend
EMAIL_FROM=""

# Protects /api/cron/* (Vercel Cron sends it automatically). Generate: openssl rand -hex 32
CRON_SECRET=""

# Public app URL used in emails and redirects (defaults to AUTH_URL)
# APP_URL="https://ghostpm.example.com"

# Shown on Terms / Privacy pages and the footer
# e.g. NEXT_PUBLIC_LEGAL_ENTITY="Acme Software LLC", NEXT_PUBLIC_CONTACT_EMAIL="support@acme.com",
#      NEXT_PUBLIC_LEGAL_JURISDICTION="the State of Delaware, USA"
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LEGAL_JURISDICTION=""

# Comma-separated emails or GitHub usernames with access to /admin
ADMIN_EMAILS=""

# Sentry (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Encrypts GitHub OAuth tokens at rest (32 bytes). Generate: openssl rand -hex 32
# If unset, a key is derived from AUTH_SECRET. Changing it later requires users to sign in again.
TOKEN_ENCRYPTION_KEY=""

# Optional Claude tuning
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max (supported models only)
# ANTHROPIC_FALLBACKS=off        # disable server-side refusal fallbacks (on by default for supported models)

# Local only: shows a "Dev sign-in" button so you can try the app without a GitHub OAuth app.
# Ignored in production builds.
# ENABLE_DEV_LOGIN=true
